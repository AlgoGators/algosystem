[importlinter]
root_package = algosystem
include_external_packages = True

[importlinter:contract:backtesting_layers]
name = Interfaces, backtesting application, and backtesting domain layers
type = layers
layers =
    algosystem.interfaces
    algosystem.backtesting.application
    algosystem.backtesting.domain

[importlinter:contract:marketdata_layers]
name = Interfaces, marketdata application, and marketdata domain layers
type = layers
layers =
    algosystem.interfaces
    algosystem.marketdata.application
    algosystem.marketdata.domain

[importlinter:contract:validation_layers]
name = Interfaces, validation application, and validation domain layers
type = layers
layers =
    algosystem.interfaces
    algosystem.validation.application
    algosystem.validation.domain

[importlinter:contract:validation_infrastructure_is_adapter_only]
name = Validation infrastructure depends on validation domain only
type = forbidden
source_modules =
    algosystem.validation.infrastructure
forbidden_modules =
    algosystem.validation.application
    algosystem.interfaces

[importlinter:contract:domain_vendor_forbidden]
name = Domains do not import vendor libraries
type = forbidden
source_modules =
    algosystem.backtesting.domain
    algosystem.marketdata.domain
    algosystem.validation.domain
forbidden_modules =
    quantstats
    yfinance
    sqlalchemy
    psycopg2
    matplotlib
    flask
    click
    rich

[importlinter:contract:validation_domain_forbidden]
name = Validation domain stays array-based and side-effect free
type = forbidden
source_modules =
    algosystem.validation.domain
forbidden_modules =
    pandas
    matplotlib
    multiprocessing
    quantstats
    webbrowser
    os

[importlinter:contract:core_no_infrastructure]
name = Domain and application layers do not import infrastructure or interfaces
type = forbidden
source_modules =
    algosystem.backtesting.application
    algosystem.backtesting.domain
    algosystem.marketdata.application
    algosystem.marketdata.domain
    algosystem.validation.application
    algosystem.validation.domain
forbidden_modules =
    algosystem.backtesting.infrastructure
    algosystem.marketdata.infrastructure
    algosystem.validation.infrastructure
    algosystem.interfaces

[importlinter:contract:bounded_context_independence]
name = Bounded context internals stay independent
type = independence
modules =
    algosystem.backtesting
    algosystem.marketdata
    algosystem.validation
ignore_imports =
    algosystem.marketdata.application.fetch_benchmark -> algosystem.backtesting
unmatched_ignore_imports_alerting = none
