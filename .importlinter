[importlinter]
root_package = algosystem
include_external_packages = True

[importlinter:contract:backtesting_layers]
name = Interfaces, backtesting application, and backtesting domain layers
type = layers
layers =
    algosystem.interfaces
    algosystem.backtesting.application
    algosystem.backtesting.domain

[importlinter:contract:marketdata_layers]
name = Interfaces, marketdata application, and marketdata domain layers
type = layers
layers =
    algosystem.interfaces
    algosystem.marketdata.application
    algosystem.marketdata.domain

[importlinter:contract:domain_vendor_forbidden]
name = Domains do not import vendor libraries
type = forbidden
source_modules =
    algosystem.backtesting.domain
    algosystem.marketdata.domain
forbidden_modules =
    quantstats
    yfinance
    sqlalchemy
    psycopg2
    matplotlib
    flask
    click
    rich

[importlinter:contract:core_no_infrastructure]
name = Domain and application layers do not import infrastructure or interfaces
type = forbidden
source_modules =
    algosystem.backtesting.application
    algosystem.backtesting.domain
    algosystem.marketdata.application
    algosystem.marketdata.domain
forbidden_modules =
    algosystem.backtesting.infrastructure
    algosystem.marketdata.infrastructure
    algosystem.interfaces

[importlinter:contract:bounded_context_independence]
name = Backtesting and marketdata internals stay independent
type = independence
modules =
    algosystem.backtesting
    algosystem.marketdata
ignore_imports =
    algosystem.marketdata.application.fetch_benchmark -> algosystem.backtesting
unmatched_ignore_imports_alerting = none
